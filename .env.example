# Copy this file to .env and fill in the values below.

# Port this app listens on.
PORT=3000

# Replace "your-domain-here" with the domain where this app is hosted and send it to info@throughputer.com
# You will get a reply with the client_id.
GRAFWORD_REDIRECT_URI=https://your-domain-here/callback

# Base URL of the Grafword server you're integrating with.
GRAFWORD_ORIGIN=https://login.grafword.com

# Filled in after Grafword's team registers this app - see README.md
# "Getting a client_id".
GRAFWORD_CLIENT_ID=

# Random string used to sign the session cookie. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=


